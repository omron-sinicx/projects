---
import { CATEGORIES, categoryHref, type CategoryId } from '../lib/categories';

interface Props {
  /** `all` on the top page. */
  active: CategoryId | 'all';
  counts: Record<CategoryId | 'all', number>;
}

const { active, counts } = Astro.props;
const tabs = [
  { id: 'all' as const, name: 'All', href: import.meta.env.BASE_URL },
  ...CATEGORIES.map((c) => ({ id: c.id, name: c.name, href: categoryHref(c) })),
].filter((t) => counts[t.id] > 0);
---

<nav aria-label="Research areas" class="border-b border-fg">
  <ul class="shell flex list-none flex-wrap justify-center gap-x-1.5 gap-y-1 py-[18px]">
    {
      tabs.map((t) => (
        <li>
          <a
            href={t.href}
            aria-current={t.id === active ? 'page' : undefined}
            class="tab relative inline-flex min-h-11 items-center gap-1 px-3 text-[13px] no-underline"
          >
            {t.name}
            <span class="self-start pt-3 text-[10px]">{counts[t.id]}</span>
            {t.id === active && <span aria-hidden="true" class="indicator" />}
          </a>
        </li>
      ))
    }
  </ul>
</nav>

<style>
  .tab {
    color: var(--color-muted);
    font-weight: 500;
  }
  .tab:hover,
  .tab[aria-current='page'] {
    color: var(--color-fg);
  }
  .tab[aria-current='page'] {
    font-weight: 600;
  }
  .indicator {
    position: absolute;
    right: 12px;
    bottom: 6px;
    left: 12px;
    height: 2px;
    border-radius: 2px;
    background: var(--color-accent);
    view-transition-name: tab-indicator;
  }
</style>
