---
import Base from '../../layouts/Base.astro';
import AreaTabs from '../../components/AreaTabs.astro';
import ProjectGrid from '../../components/ProjectGrid.astro';
import ThemeStrip from '../../components/ThemeStrip.astro';
import ProjectModal from '../../components/ProjectModal.astro';
import { CATEGORIES } from '../../lib/categories';
import { areas, getProjects } from '../../lib/projects';

export function getStaticPaths() {
  return CATEGORIES.map((category) => ({ params: { area: category.slug }, props: { category } }));
}

const { category } = Astro.props;
const { sections, counts } = areas(await getProjects());
const section = sections.find((s) => s.category.id === category.id);
---

<Base title={`${category.title} — SINIC X Research Projects`}>
  <AreaTabs active={category.id} counts={counts} />
  <section class="shell pt-7 pb-6">
    <nav aria-label="Breadcrumb">
      <a href={import.meta.env.BASE_URL} class="inline-flex min-h-11 items-center gap-1.5 px-1 text-[13px] font-semibold text-fg no-underline hover:text-accent">
        <svg aria-hidden="true" width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.2" stroke-linecap="round" stroke-linejoin="round"><path d="M19 12H5M11 18l-6-6 6-6" /></svg>
        All
      </a>
    </nav>
    <div class="mt-5 mb-9 flex flex-wrap items-start gap-2.5" style={`view-transition-name: cat-${category.id}`}>
      <span aria-hidden="true" class="font-display text-lg leading-none text-accent">{section?.no}</span>
      <h1 class="m-0 font-display text-[clamp(30px,5vw,44px)] leading-none font-normal">{category.title}</h1>
      <span class="ml-1.5 self-center text-sm text-muted">{section?.count ?? 0} projects</span>
    </div>
    {
      section && section.themes.length > 0 && (
        <div class="mb-12">
          <ThemeStrip themes={section.themes} />
        </div>
      )
    }
    {
      section && (
        <>
          <h2 class="mt-0 mb-5 text-[13px] font-semibold tracking-[.08em] text-muted uppercase">
            All projects <span class="font-normal">· newest first</span>
          </h2>
          <ProjectGrid projects={section.all} scope={category.id} />
        </>
      )
    }
  </section>
  <ProjectModal />
</Base>

<script>
  import '../../scripts/transition';
  import '../../scripts/progressive';
</script>
